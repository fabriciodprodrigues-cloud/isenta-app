// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("viewer") // admin | operator | viewer
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([email])
}

model Account {
  id                 String   @id @default(cuid())
  name               String
  razaoSocial        String?  // obrigatório para Motiva
  cnpj               String   @unique
  status             String   @default("pending") // pending | active | inactive
  responsibleName    String
  responsibleEmail   String
  responsiblePhone   String
  address            String
  city               String
  state              String

  // Campos expandidos para portais (especialmente Motiva)
  telefone           String?  // obrigatório em Motiva
  email              String?  // obrigatório em Motiva
  cep                String?  // obrigatório em Motiva
  numero             String?  // obrigatório em Motiva
  complemento        String?  // opcional em Motiva
  bairro             String?  // obrigatório em Motiva

  // --- Identidade de envio ---
  // Toda solicitação sai na identidade do órgão, nunca na da Isenta. Os campos
  // abaixo são o que torna isso possível, e a ausência de qualquer um deles
  // bloqueia o envio (ver identidade-envio.ts).
  emailIsencao       String?  // ex: isencao@orgao.gov.br
  metodoAcessoEmail  String?  // DELEGACAO | CREDENCIAL | ENCAMINHAMENTO
  emailCredencialRef String?  // reservado para ponteiro de cofre externo
  // Credencial SMTP da caixa do órgão, cifrada em AES-256-GCM (lib/cofre.ts).
  // Nunca a senha em texto plano.
  emailCredencialCifrada String?
  emailVerificado    Boolean  @default(false) // confirmado por clique real na caixa
  // Hash do token de verificação — o valor em claro só vai no e-mail.
  emailVerifHash     String?
  emailVerifExpira   DateTime?

  // --- Leitura de respostas por IMAP ---
  // Maior UID já processado nesta caixa; null = nunca lida (a primeira
  // leitura traz só as últimas mensagens, não o histórico inteiro).
  imapUltimoUidLido  Int?
  // UIDVALIDITY da caixa na última leitura. Se mudar, os UIDs anteriores
  // podem não corresponder mais às mesmas mensagens — o cursor é
  // descartado e a leitura recomeça do zero (lib/processar-respostas.ts).
  // BigInt porque a lib IMAP expõe esse valor como BigInt.
  imapUidValidity    BigInt?

  // --- Papel timbrado ---
  timbreUrl          String?  // pathname do arquivo no Blob privado
  cabecalhoTexto     String?  // ex: nome da secretaria
  cidadeEmissao      String?  // usada no fecho do ofício
  // Modelo de ofício em .docx enviado pelo órgão (cabeçalho com o timbre
  // real, corpo em branco). Opcional: sem ele o envio cai no HTML de
  // montarOficio() como hoje. Pathname no Blob privado, mesmo padrão de
  // timbreUrl.
  modeloOficioUrl    String?

  // --- Assinatura ---
  metodoAssinatura   String?  // GOVBR_ICP | ELETRONICA_INTERNA
  responsibleRole    String?  // cargo de quem assina
  assinaturaRef      String?  // referência ao fluxo de assinatura no cofre

  // Numeração de ofício é por órgão, no formato NNN/AAAA.
  proximoNumeroOficio Int     @default(1)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users        User[]
  vehicles     Vehicle[]
  alerts       Alert[]
  autorizacao  TermoAutorizacao?
  portais      PortalCredencial[]
  respostasRecebidas EmailRespostaRecebida[]
  artespCadastros    ArtespCadastro[]
  solicitacoesIsencaoLote SolicitacaoIsencaoLote[]
  contratos          Contrato[]

  @@index([cnpj])
  @@index([status])
}

/// Um e-mail de resposta lido da caixa institucional do órgão, ainda não
/// confirmado por um humano.
///
/// Nunca aplica status em ConcesssionaireRegistration sozinho — mesmo com
/// classificação "óbvia", existe sempre um clique de confirmação antes,
/// pelo mesmo princípio já usado na leitura de CRLV
/// (lib/leitura-crlv-texto.ts): extração automática é palpite, não decisão.
model EmailRespostaRecebida {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// UID da mensagem na caixa do órgão — dedupe e continuidade do cursor.
  imapUid     Int
  remetente   String
  assunto     String
  recebidoEm  DateTime?

  /// Trecho do corpo (texto), truncado — o bastante pra dar contexto na
  /// tela sem guardar o e-mail inteiro.
  corpoResumo String?

  /// Protocolo (formato ISN-AAAA-XXXXXX) encontrado no assunto ou corpo.
  protocoloDetectado     String?
  /// aprovado | recusado | indefinido — palpite do classificador, nunca
  /// aplicado sozinho.
  classificacaoDetectada String

  /// ConcesssionaireRegistration que bateriam pelo protocolo — pode ser
  /// mais de uma (um protocolo cobre o lote inteiro enviado junto).
  registrationIds String[]

  status         String    @default("pendente") // pendente | confirmado | ignorado
  /// O que o humano de fato escolheu — pode divergir de classificacaoDetectada.
  confirmadoComo String?   // aprovado | recusado
  confirmadoPor  String?   // e-mail do usuário admin
  confirmadoEm   DateTime?

  createdAt DateTime @default(now())

  @@unique([accountId, imapUid])
  @@index([accountId])
  @@index([status])
  @@index([protocoloDetectado])
}

/// Acesso do órgão a um portal de concessionária.
///
/// A conta no portal é do órgão, criada uma vez pela equipe — o cadastro exige
/// código enviado por e-mail, o que inviabiliza automatizar essa etapa e não
/// compensa, já que ocorre uma única vez.
///
/// Um registro por par órgão + portal: o mesmo portal atende várias
/// concessionárias (o da Motiva cobre oito), então a chave é o portal, não a
/// concessionária.
model PortalCredencial {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Identificador do portal, ex.: CCR_MOTIVA.
  portal    String
  /// E-mail da conta, guardado em claro por ser identificador, não segredo.
  usuario   String
  /// Senha cifrada em AES-256-GCM (lib/cofre.ts).
  senhaCifrada String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, portal])
  @@index([portal])
}

/// Termo que autoriza a Isenta a agir em nome do órgão.
///
/// Sem ele ativo, nenhum envio ocorre: operar a caixa de e-mail e os portais de
/// um órgão público exige respaldo documental explícito.
model TermoAutorizacao {
  id         String    @id @default(cuid())
  accountId  String    @unique
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  arquivoUrl String?   // pathname do termo assinado no Blob privado
  poderes    String[]  // ENVIAR_EMAIL_NOME_ORGAO | OPERAR_PORTAIS_NOME_ORGAO
  assinadoEm DateTime?
  validoAte  DateTime?
  ativo      Boolean   @default(false)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([ativo])
}

model Vehicle {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  plate             String
  renavam           String   // obrigatório em Motiva
  type              String   // proprio | locado
  category          String   // oficial | ambulancia | bombeiro | outro
  status            String   @default("rascunho") // rascunho | enviado | aguardando | aprovado | recusado | vencido

  // Campos expandidos para portais
  cor               String?  // obrigatório em Motiva
  marca             String?  // opcional em Motiva
  modelo            String?  // obrigatório em Motiva
  anoFabricacao     Int?     // obrigatório em Motiva
  anoModelo         Int?     // obrigatório em Motiva

  documentUrl       String?
  contractUrl       String?  // se locado
  crlvUrl           String?
  tagSerialNumber   String?

  expiresAt         DateTime?
  lastRenewalAt     DateTime?
  lastAlertSentAt   DateTime? // para não enviar múltiplos alertas no mesmo dia

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  registrations ConcesssionaireRegistration[]
  alerts        Alert[]
  documents     Document[]
  tags          Tag[]
  artespVeiculos ArtespVeiculo[]
  contratoVeiculos ContratoVeiculo[]

  @@unique([accountId, plate])
  @@index([accountId])
  @@index([status])
  @@index([expiresAt])
}

model ConcesssionaireRegistration {
  id                String   @id @default(cuid())
  vehicleId         String
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  concessionaireId  String
  concessionaire    Concessionaire @relation(fields: [concessionaireId], references: [id], onDelete: Restrict)

  status            String   @default("rascunho") // rascunho | enviado | aguardando_resposta | aprovado | recusado
  protocol          String?

  sentAt            DateTime?
  approvedAt        DateTime?
  rejectionReason   String?

  // --- Execução pelo robô de portal ---
  /// Quantas vezes o robô já tentou. Serve para desistir depois de N falhas
  /// em vez de repetir indefinidamente contra um portal que mudou.
  rpaTentativas     Int      @default(0)
  rpaUltimoErro     String?
  /// Capturas de tela de cada etapa, no Blob. São a única forma de auditar o
  /// que o robô viu quando algo deu errado.
  rpaCapturas       String[]
  rpaExecutadoEm    DateTime?
  /// Preenchido quando o robô precisa de decisão humana antes de prosseguir.
  rpaAguardando     String?

  /// Vínculo opcional ao item do lote de disparo nacional que gerou esta
  /// linha (ver SolicitacaoIsencaoItem) -- null para linhas criadas pelo
  /// fluxo manual de sempre (RequestExemptionModal).
  loteItemId        String?
  loteItem          SolicitacaoIsencaoItem? @relation(fields: [loteItemId], references: [id], onDelete: SetNull)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([vehicleId, concessionaireId])
  @@index([vehicleId])
  @@index([concessionaireId])
  @@index([status])
  @@index([loteItemId])
}

// --- Módulo Imunidade Nacional (disparo em lote pra todas as
// concessionárias ativas de um órgão de uma vez) ---
//
// Entidade própria (não um cálculo em cima de ConcesssionaireRegistration):
// o lote é o registro do evento de disparo; cada item é o status por
// concessionária. A execução de fato (e-mail, leitura de confirmação)
// reaproveita processRegistration/confirmarResposta -- ver
// registration-orchestrator.ts e processar-respostas.ts.

model SolicitacaoIsencaoLote {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  disparadaPor String   // email do admin que disparou
  dataDisparo  DateTime @default(now())

  escopo       String   @default("NACIONAL")      // NACIONAL | PERSONALIZADO
  status       String   @default("EM_ANDAMENTO")  // EM_ANDAMENTO | CONCLUIDO_TOTAL | CONCLUIDO_PARCIAL

  itens        SolicitacaoIsencaoItem[]

  createdAt    DateTime @default(now())

  @@index([accountId])
}

model SolicitacaoIsencaoItem {
  id               String   @id @default(cuid())
  loteId           String
  lote             SolicitacaoIsencaoLote @relation(fields: [loteId], references: [id], onDelete: Cascade)

  concessionariaId String
  concessionaria   Concessionaire @relation(fields: [concessionariaId], references: [id], onDelete: Restrict)

  metodo    String  @default("EMAIL_OFICIO") // EMAIL_OFICIO -- único suportado no MVP
  status    String  @default("PENDENTE_PRE_REQUISITO")
  // PENDENTE_PRE_REQUISITO | NA_FILA | ENVIADA | CONFIRMADA | COM_PROBLEMA | CANCELADA

  protocolo       String?
  dataEnvio       DateTime?
  dataConfirmacao DateTime?
  ultimoErro      String?
  tentativas      Int      @default(0)

  registrations   ConcesssionaireRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([loteId, concessionariaId])
  @@index([concessionariaId])
  @@index([status])
}

model Alert {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type      String   // expiring_soon | expired | renewal_needed
  daysUntilExpiry Int
  sentAt    DateTime?

  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([vehicleId])
  @@index([type])
  @@index([sentAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expires])
}

/// Token de redefinicao de senha.
///
/// Guarda o hash do token, nunca o valor em claro: se o banco vazar, os
/// tokens em transito nao servem para nada. Mesmo raciocinio da coluna de
/// senha.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Concessionaire {
  id                  String    @id @default(cuid())
  name                String    @unique
  cnpj                String?   @unique
  grupo               String?
  esfera              String    @default("FEDERAL")  // FEDERAL | ESTADUAL | MUNICIPAL
  regulador           String
  email               String?
  phone               String?
  website             String?
  cidade              String?
  estados             String?   // JSON array: ["SP","RJ"] or comma-separated
  rodovias            String?   // JSON array or comma-separated
  extensaoKm          Float?
  situacao            String    @default("ATIVO")   // ATIVO | CONTRATO_ENCERRADO | EM_LEILAO | PLANEJADO
  canalIsentos        String?
  tipoCanal           String?   // PORTAL_WEB | EMAIL | PORTAL_MAIS_ATENDIMENTO | MANUAL
  prazoRenovMeses     Int?
  observacoes         String?
  ativoParaCadastro   Boolean   @default(false)
  camposObrigatorios  String?   // JSON array: ["placa","renavam","cor","modelo","anoFabricacao","anoModelo"]
  // Concessionária de demonstração (ex.: "Concessionária Teste"): permite
  // solicitar o mesmo veículo várias vezes, sem o bloqueio de duplicidade
  // que vale pras concessionárias reais. Serve pra órgão mostrar o fluxo
  // de e-mail pra outros órgãos sem esbarrar em "já existe uma solicitação".
  permiteSolicitacoesIlimitadas Boolean @default(false)

  registrations ConcesssionaireRegistration[]
  solicitacaoIsencaoItens SolicitacaoIsencaoItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([situacao])
  @@index([ativoParaCadastro])
  @@index([regulador])
}

model Tag {
  id                String   @id @default(cuid())
  serialNumber      String   @unique
  vehicleId         String?
  vehicle           Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  // Sem vinculo com concessionaria: a TAG e aceita em todas elas.

  // Marca/operadora que emitiu a TAG (ex.: ConectCar, Sem Parar, Veloe).
  // Importa pro modulo ARTESP: a Portaria 56/2025 exige que a TAG seja de
  // uma OSA autorizada pela ARTESP -- so a ConectCar esta confirmada como
  // tal ate agora, entao o operador precisa saber qual e a marca de cada
  // veiculo antes de protocolar.
  operadora         String?

  status            String   @default("available") // available | assigned | expired | inactive
  assignedAt        DateTime?
  expiresAt         DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([vehicleId])
  @@index([status])
}

model Document {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type        String   // crlv | contract | registration | other
  url         String
  fileName    String
  fileSize    Int

  uploadedBy  String   // email do usuário que fez upload
  uploadedAt  DateTime @default(now())

  @@index([vehicleId])
  @@index([type])
  @@index([uploadedAt])
}

// --- Módulo ARTESP (Portaria ARTESP nº 56/2025) ---
//
// Diferente de ConcesssionaireRegistration (uma linha por veículo x
// concessionária), a ARTESP tem cadastro único por órgão cobrindo a frota
// inteira -- por isso um modelo próprio em vez de reaproveitar aquele.

model ArtespCadastro {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  tipoEntidade String  // A (estadual SP/SIGEF) | B (municipio/outro estado)
  abrangencia  String? // texto conforme tipoEntidade -- ver Portaria Art. 2º, §1º/§2º

  responsavelFrotaNome     String?
  responsavelFrotaTelefone String?
  responsavelFrotaEmail    String?

  status         String    @default("rascunho") // rascunho | documentos_gerados | protocolado | deferido | indeferido | exigencia
  protocolo      String?
  protocoladoEm  DateTime?
  protocoladoPor String?
  decisaoEm      DateTime?
  decisaoObs     String?

  // Preenchido pelo disparo único (POST .../enviar) -- endereço usado no
  // envio do dossiê à ARTESP, não necessariamente o mesmo de um eventual
  // protocolo manual feito depois.
  emailArtespEnviadoPara String?

  veiculos   ArtespVeiculo[]
  documentos ArtespDocumento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([status])
}

model ArtespVeiculo {
  id               String         @id @default(cuid())
  artespCadastroId String
  artespCadastro   ArtespCadastro @relation(fields: [artespCadastroId], references: [id], onDelete: Cascade)
  vehicleId        String
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  // Específicos da ARTESP (Art. 6º) -- não pertencem ao Vehicle em geral.
  registroPatrimonial String?
  prefixo             String?

  @@unique([artespCadastroId, vehicleId])
  @@index([vehicleId])
}

model ArtespDocumento {
  id               String         @id @default(cuid())
  artespCadastroId String
  artespCadastro   ArtespCadastro @relation(fields: [artespCadastroId], references: [id], onDelete: Cascade)

  tipo        String    // requerimento | declaracao_tag | anexo_veiculos | declaracao_concordancia | solicitacao_cobranca
  status      String    @default("gerado") // gerado | assinado
  urlGerado   String?
  urlAssinado String?
  geradoEm    DateTime?
  assinadoEm  DateTime?

  @@unique([artespCadastroId, tipo])
  @@index([artespCadastroId])
}

// --- Módulo Financeiro (contratos, faturas, cobrança) ---
//
// Uso interno do time comercial/financeiro da Isenta -- o operador (órgão)
// nunca acessa isto. Dinheiro em centavos (Int), não Decimal: o projeto não
// usa Decimal em lugar nenhum, e o Decimal do Prisma serializa como string
// no JSON (quebra silenciosa pra quem consumir a API sem saber). "Vencido"
// e "atrasada" não são status persistidos -- são calculados a partir de
// dataVencimento na hora da consulta (ver lib/financeiro.ts), porque não há
// onde rodar um job proativo (os 2 crons do Hobby já estão ocupados, e
// apps/worker está morto). Isso também evita status desatualizado.

model Contrato {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Se este é um "mini-contrato" gerado por adição de veículo, aponta pro
  /// contrato raiz do órgão. Cada um renova com seu próprio vencimento --
  /// nunca se fundem (decisão confirmada com o usuário).
  contratoPaiId   String?
  contratoPai     Contrato?  @relation("ContratoPai", fields: [contratoPaiId], references: [id], onDelete: SetNull)
  contratosFilhos Contrato[] @relation("ContratoPai")

  precoUnitarioMensalCentavos Int
  /// Quantidade no fechamento -- pra contagem ATUAL de veículos cobertos,
  /// contar veiculos.filter(ativo) em vez de usar este campo.
  qtdVeiculos                 Int
  /// precoUnitarioMensalCentavos * 12 * qtdVeiculos. Fica congelado como
  /// histórico do que foi de fato pago -- remover veículo depois não
  /// recalcula (decisão confirmada: sem estorno/crédito).
  valorTotalPeriodoCentavos   Int

  dataInicio     DateTime
  dataVencimento DateTime

  modalidadeContratacao String  // licitacao_pregao | dispensa_valor | inexigibilidade | adesao_ata | compra_direta | outro
  numeroProcesso        String?

  /// Só os estados que dependem de ação humana. "Vencido" é calculado
  /// (dataVencimento < hoje && status='ativo'), não fica guardado aqui.
  status      String  @default("ativo") // ativo | cancelado
  observacoes String?

  veiculos        ContratoVeiculo[]
  faturas         Fatura[]
  historicoPrecos HistoricoPrecoContrato[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([status])
  @@index([dataVencimento])
}

model ContratoVeiculo {
  id         String   @id @default(cuid())
  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  dataInclusao DateTime  @default(now())
  /// Preenchido quando removido do contrato -- sem estorno, só marca
  /// ativo:false (decisão confirmada). valorTotalPeriodoCentavos do
  /// contrato não muda.
  dataExclusao DateTime?
  ativo        Boolean   @default(true)

  @@unique([contratoId, vehicleId])
  @@index([vehicleId])
}

model Fatura {
  id         String   @id @default(cuid())
  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  tipo           String  // fechamento_inicial | renovacao | aditivo
  valorCentavos  Int
  formaPagamento String  // boleto | pix | empenho | ordem_bancaria | outro
  numeroEmpenho  String?
  parcelaNumero  Int?
  parcelaTotal   Int?

  dataEmissao    DateTime  @default(now())
  dataVencimento DateTime
  dataPagamento  DateTime?

  /// "Atrasada" é calculado (dataVencimento < hoje && status em
  /// emitida/aguardando_empenho), não guardado aqui -- nunca fica
  /// desatualizado, e marcar como paga é sempre ação humana explícita.
  status String @default("emitida") // emitida | aguardando_empenho | paga | cancelada

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contratoId])
  @@index([status])
  @@index([dataVencimento])
}

/// Auditoria de reajuste -- alimenta o relatório de "descontos concedidos"
/// (comparação com ConfiguracaoFinanceira.precoReferenciaMensalCentavos).
model HistoricoPrecoContrato {
  id         String   @id @default(cuid())
  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  precoAnteriorCentavos Int
  precoNovoCentavos     Int
  dataAlteracao         DateTime @default(now())
  motivo                String?

  @@index([contratoId])
}

/// Linha única (id fixo). Só pré-preenche o formulário de novo contrato --
/// mudar isto nunca afeta contratos já existentes, que guardam seu próprio
/// precoUnitarioMensalCentavos.
model ConfiguracaoFinanceira {
  id                            String   @id @default("singleton")
  precoReferenciaMensalCentavos Int      @default(9990) // R$ 99,90
  updatedAt                     DateTime @updatedAt
}

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/isenta"

# Resend (E-mail)
RESEND_API_KEY="re_xxx"

# Cloudflare R2
R2_ACCOUNT_ID="xxx"
R2_ACCESS_KEY_ID="xxx"
R2_SECRET_ACCESS_KEY="xxx"
R2_BUCKET_NAME="isenta"

# Auth.js (NextAuth)
NEXTAUTH_SECRET="xxx"
NEXTAUTH_URL="http://localhost:3000"

# Redis (para filas de jobs)
REDIS_URL="redis://localhost:6379"

# App
# NAO definir NODE_ENV. O Next.js ja o define sozinho (development em
# `next dev`, production em `next build`). Forcar o valor faz o build gerar um
# bundle com runtime React misto (dev + prod) e a geracao estatica falha com
# "Cannot read properties of null (reading 'useContext')".
APP_URL="http://localhost:3000"
